# Marília Day - Environment Variables Configuration

# 1. Supabase (PostgreSQL Database & API)
# Obtenha no painel do seu projeto Supabase: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 2. Spotify Web API (Client Credentials Flow)
# Crie seu app em: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# ID de Artista Spotify da Marília Mendonça: 1yR2vrVuuzJGkc5kENHL9o
SPOTIFY_ARTIST_ID=1yR2vrVuuzJGkc5kENHL9o

# 3. YouTube Data API v3
# Ative em: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# ID do Canal Oficial da Marília Mendonça: UClAUj1i8c1sL-CgXvI_qO-A
YOUTUBE_CHANNEL_ID=UClAUj1i8c1sL-CgXvI_qO-A

# 4. App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
